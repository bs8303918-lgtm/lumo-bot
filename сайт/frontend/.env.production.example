# Vercel → Settings → Environment Variables (Production)

# URL Railway — ТОЛЬКО домен, БЕЗ /api:

# ✅ https://lumo-bot-production-9903.up.railway.app

VITE_API_URL=https://your-railway-service.up.railway.app



# Google Cloud Console → OAuth 2.0 Client ID (Web)

# Authorized JavaScript origins: https://your-vercel-domain.vercel.app

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


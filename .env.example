# Lumo — переменные окружения. Только имена: значения по умолчанию см. в config.py.
# Скопируй в .env и заполни. Файл .env в git не коммитить.


# Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_IDS=
ADMIN_ANALYTICS_LIVE=
SUPPORT_TELEGRAM_USERNAME=

# Telethon
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELETHON_SESSION_NAME=

# Railway: строка сессии (переживает redeploy без Volume). Получить: python scripts/export_telethon_session.py

# Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Доп. админы через запятую (если нужно несколько)
# TELEGRAM_ADMIN_IDS=123456789,987654321
# LLM на интерес: локально, LLM только если <2 категорий (см. LLM_INTEREST_CATEGORIZATION)
LLM_INTEREST_CATEGORIZATION=true
# Live-логи воронки в админ-чат (true/false)
ADMIN_ANALYTICS_LIVE=false
SUPPORT_TELEGRAM_USERNAME=taton4i

# Telethon (user session)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELETHON_SESSION_NAME=lumo_session

# Database (SQLite for dev, Supabase/Railway PostgreSQL for prod)
# Supabase: Project Settings → Database → Connection string → URI
# Вставь как есть — код сам добавит +asyncpg
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Railway Postgres: Add Reference → DATABASE_URL from Postgres service
DATABASE_URL=sqlite+aiosqlite:///./lumo.db

# full = Railway prod (bot+worker); worker = API без polling; bot = только polling локально
LUMO_MODE=full
SKIP_INSTANCE_LOCK=false
# Volume на Railway: TELETHON_SESSION_PATH=/data/lumo_session
# TELETHON_SESSION_PATH=

# LLM — рекомендуем Groq (бесплатно ~14 400 запросов/день, без карты)
# Ключ: https://console.groq.com/keys
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# Альтернатива — Google Gemini (~1500 запросов/день)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Ollama локально (без лимитов, если ПК всегда включён):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# Limits & intervals
AI_SEARCH_DAILY_LIMIT=3
NOTIFICATION_DIGEST_SIZE=3
NOTIFICATION_DIGEST_MAX_FLUSH=3
DIGEST_COOLDOWN_HOURS=12
CATALOG_NOTIFY_MIN_SCORE=3.0
MONITOR_INTERVAL_MINUTES=1440
MONITOR_INITIAL_POSTS_LIMIT=10
MONITOR_INITIAL_MAX_AGE_DAYS=7
CATALOG_NO_DEADLINE_MAX_AGE_DAYS=7
LLM_MAX_MESSAGE_AGE_DAYS=3
LLM_MAX_CONCURRENT=1
LLM_MAX_PAIRS_PER_CYCLE=2
LLM_PROCESSOR_INTERVAL_SECONDS=1200
LLM_HEALTH_CHECK_INTERVAL_SECONDS=3600
LLM_PENDING_SCAN_LIMIT=20
LLM_MAX_MESSAGE_AGE_DAYS=2
LLM_REANALYZE_RECENT_COUNT=10
LLM_ONBOARDING_MAX_PAIRS=3
LLM_ONBOARDING_SEED_SCAN_LIMIT=15
LLM_CLASSIFY_BATCH_LIMIT=5
LLM_BACKFILL_BATCH_LIMIT=5
LLM_ENABLE_PAIR_RELEVANCE=false
LLM_REQUEST_DELAY_SECONDS=5
LLM_429_MAX_RETRIES=1
LLM_429_RETRY_BASE_SECONDS=8
TELETHON_REQUEST_DELAY_SECONDS=2
REQUIRE_PUBLIC_CHANNELS=true

# Paths
SEED_CHANNELS_FILE=data/seed_channels.txt
LOG_DIR=logs

# REST API — витрина грантов (AI Startify Grants)
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://your-mini-app.vercel.app
API_ACCESS_TOKEN=
API_ALLOW_DEV_AUTH=false
API_ENABLED=true
AUTO_BUILD_WEBAPP=true
# Railway worker: false (Mini App on Vercel). Local dev: true
SERVE_MINI_APP=true
# Railway API URL (без /app/)
PUBLIC_BASE_URL=
# Vercel Mini App URL (корень, без /app/) — кнопка Open в Telegram
TELEGRAM_WEBAPP_URL=
TELEGRAM_BOT_USERNAME=LumoAI1bot
MINI_APP_MENU_TEXT=Open
COMMUNITY_TELEGRAM_HANDLE=Lumo Community
COMMUNITY_TELEGRAM_URL=https://t.me/+hA0CwgbStLI0MGRi

# Сбор данных для будущего обучения моделей (true/false)
TRAINING_DATA_ENABLED=true
# TRAINING_DATA_DIR=data/training

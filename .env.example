DATABASE_URL=

# LLM — gemini (Google) или openai (Groq, OpenRouter, Ollama и др.)
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Отдельный Groq-ключ только для категоризации интересов пользователей (не делит лимит с мониторингом)
OPENAI_USER_API_KEY=
LLM_USER_MAX_CONCURRENT=
LLM_USER_REQUEST_DELAY_SECONDS=

# Limits & intervals

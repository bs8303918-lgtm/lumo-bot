# Vercel → Settings → Environment Variables
# URL Railway — ТОЛЬКО домен, БЕЗ /api в конце:
# ✅ https://your-lumo-bot.up.railway.app
# ❌ https://your-lumo-bot.up.railway.app/api
VITE_API_URL=https://your-lumo-bot.up.railway.app
# На Vercel корень сайта, не /app/
VITE_BASE_PATH=/
# Google Cloud Console → OAuth client (Web application) → Client ID.
# Must match GOOGLE_OAUTH_CLIENT_ID on the Railway API — required to gate the Mini App behind Google sign-in.
VITE_GOOGLE_CLIENT_ID=

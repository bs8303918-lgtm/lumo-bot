{
  "manifest_version": 3,
  "name": "Lumo — новые конкурсы и гранты",
  "short_name": "Lumo",
  "version": "0.1.0",
  "description": "Быстрая проверка новых конкурсов, грантов и стипендий из каталога Lumo прямо из браузера.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lumo — конкурсы"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://lumo-bot-production-9903.up.railway.app/*"
  ]
}

# Скопируй в Railway → lumo-bot → Variables → Raw Editor
# Любую строку можно добавить отдельно: New Variable → Name + Value → Redeploy
# Mini App на Vercel — см. docs/VERCEL.md

LUMO_MODE=full
# Split на 2 Railway-сервиса: api (только API) + worker (бот/monitor/LLM)
# LUMO_MODE=api          → сервис 1: Mini App API, ~200 MB RAM
# LUMO_MODE=worker       → сервис 2: monitor + LLM
# ENABLE_BOT_POLLING=true → на worker-сервисе включить Telegram polling
# ENABLE_BOT_POLLING=false
SERVE_MINI_APP=false
AUTO_BUILD_WEBAPP=false
SKIP_INSTANCE_LOCK=true

# Supabase Session pooler :5432 (лучше для Railway IPv4). Код сам меняет :6543→:5432.
# Если tenant not found — скопируй хост из Supabase Connect и задай:
# SUPABASE_POOLER_HOST=aws-0-eu-central-1.pooler.supabase.com
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_PHONE=

# Telethon — лучше строка сессии (переживает redeploy), чем Volume:
# Локально: telethon_login_qr.py → export_telethon_session.py → вставь в Railway:
# TELETHON_SESSION_STRING=1AgA...
# TELETHON_SESSION_PATH=/data/lumo_session

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# Railway domain (Settings → Networking → Generate Domain)
PUBLIC_BASE_URL=https://your-service.up.railway.app
# Vercel Mini App URL
TELEGRAM_WEBAPP_URL=https://your-app.vercel.app
API_CORS_ORIGINS=https://your-app.vercel.app

API_ENABLED=true

# AI Startify B2B (тот же ключ — в NestJS как LUMO_PARTNER_API_KEY)
PARTNER_API_KEY=lumo_partner_I_xakIY1cpbkT_UNYar6yyHa0i-CBN40WpAo_Z9ALBE
SUBSCRIPTIONS_ENFORCED=false
SUBSCRIPTION_PREVIEW_ENABLED=true
STARTIFY_CHECKOUT_URL=https://startify.example/lumo/checkout
# Lumo POST сюда каждый новый конкурс (см. docs/STARTIFY_CATALOG_WEBHOOK.md)
STARTIFY_CATALOG_WEBHOOK_URL=https://api.startify.example/api/webhooks/lumo/catalog
STARTIFY_CATALOG_PUSH_ENABLED=true
KASPI_PAYMENT_PHONE=+7 775 499 8313
SUBSCRIPTION_REMINDER_INTERVAL_SECONDS=3600
